generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  OWNER
  ADMIN
}

enum OrderSource {
  ADMIN
  CLIENT_LINK
}

enum OrderStatus {
  PENDING_REVIEW
  WAITING_ACC_PAYMENT
  PRODUCTION_QUEUE
  IN_PROGRESS
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum DesignStatus {
  PENDING
  WAITING_ACC
  REVISION_REQUESTED
  APPROVED
}

enum ServiceCategory {
  CUP
  PLASTIK
  DTF_BAJU
  LAINNYA
}

enum PickupMethod {
  SELF_PICKUP
  INSTANT_COURIER
  EXPEDITION
}

enum PaymentMethod {
  TRANSFER
  TUNAI
  QRIS
}

enum CashFlowType {
  INCOME
  EXPENSE
}

// ==========================================
// MODELS (8 CORE TABLES)
// ==========================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(ADMIN)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model RawMaterial {
  id        String          @id @default(cuid())
  name      String
  category  ServiceCategory
  stockQty  Int             @default(0) @map("stock_qty")
  minStock  Int             @default(100) @map("min_stock")
  unit      String          @default("pcs")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@map("raw_materials")
}

model Order {
  id               String       @id @default(cuid())
  uuid             String       @unique @default(uuid())
  orderCode        String       @unique @map("order_code")
  source           OrderSource  @default(ADMIN)
  customerName     String       @map("customer_name")
  customerWa       String       @map("customer_wa")
  status           OrderStatus  @default(WAITING_ACC_PAYMENT)
  designStatus     DesignStatus @default(PENDING) @map("design_status")
  revisionCount    Int          @default(0) @map("revision_count")
  pickupMethod     PickupMethod @default(SELF_PICKUP) @map("pickup_method")
  trackingNumber   String?      @map("tracking_number")
  totalPrice       Int          @default(0) @map("total_price")
  currentMockupUrl String?      @map("current_mockup_url")
  notes            String?      @db.Text

  // Idempotency guard to prevent double stock deduction
  stockDeducted    Boolean      @default(false) @map("stock_deducted")

  // Soft-cancel & refund fields
  cancelledAt      DateTime?    @map("cancelled_at")
  cancelReason     String?      @map("cancel_reason") @db.Text
  refundAmount     Int          @default(0) @map("refund_amount")

  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  items            OrderItem[]
  revisions        OrderRevision[]
  payments         OrderPayment[]
  cashFlows        CashFlow[]

  @@index([status])
  @@index([designStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id            String          @id @default(cuid())
  orderId       String          @map("order_id")
  category      ServiceCategory
  rawMaterialId String?         @map("raw_material_id")
  itemName      String          @map("item_name")
  specs         Json
  qty           Int
  unitPrice     Int             @default(0) @map("unit_price")
  subtotal      Int             @default(0)
  logoUrl       String?         @map("logo_url")
  createdAt     DateTime        @default(now()) @map("created_at")

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rawMaterial   RawMaterial?    @relation(fields: [rawMaterialId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model OrderRevision {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  version    Int
  mockupUrl  String   @map("mockup_url")
  clientNote String?  @map("client_note") @db.Text
  adminNote  String?  @map("admin_note") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, version])
  @@map("order_revisions")
}

model OrderPayment {
  id            String        @id @default(cuid())
  orderId       String        @map("order_id")
  amount        Int
  paymentMethod PaymentMethod @default(TRANSFER) @map("payment_method")
  proofUrl      String?       @map("proof_url")
  note          String?
  paidAt        DateTime      @default(now()) @map("paid_at")

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cashFlow      CashFlow?

  @@index([orderId])
  @@map("order_payments")
}

model CashFlow {
  id             String        @id @default(cuid())
  type           CashFlowType
  category       String
  amount         Int
  orderPaymentId String?       @unique @map("order_payment_id")
  orderId        String?       @map("order_id")
  description    String?       @db.Text
  date           DateTime      @default(now())
  createdAt      DateTime      @default(now()) @map("created_at")

  orderPayment   OrderPayment? @relation(fields: [orderPaymentId], references: [id], onDelete: SetNull)
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([date, type])
  @@map("cash_flows")
}

model ShopSetting {
  id             Int      @id @default(1)
  shopName       String   @default("Sablon Kemasan Custom") @map("shop_name")
  whatsappNumber String   @default("6281234567890") @map("whatsapp_number")
  address        String   @default("Alamat Workshop") @db.Text
  mapsUrl        String?  @map("maps_url")
  bankInfo       String   @default("BCA 1234567890 a.n. Pemilik") @map("bank_info") @db.Text
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("shop_settings")
}
